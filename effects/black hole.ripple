// Pulls the actor into a spinning black hole that opens at the pointer.
// SPDX-License-Identifier: MIT

vec4 effect(vec2 uv) {
    vec2 res = max(_resolution, vec2(1.0));
    vec2 scale = vec2(res.x / res.y, 1.0);
    float p = _progress;

    vec2 center = _mouseUV * scale;
    vec2 d = uv * scale - center;
    float r = length(d);

    // Points near the hole look further out: the content is pulled in
    float pull = p * p * 2.5;
    float stretch = 1.0 + pull / (r + 0.05);
    float swirl = p * p * 9.0 / (r + 0.25);

    float s = sin(swirl);
    float c = cos(swirl);
    vec2 source = vec2(d.x * c - d.y * s, d.x * s + d.y * c) * stretch;

    vec4 col = pixel((center + source) / scale);

    // The event horizon grows and swallows what reaches it
    float horizon = p * 0.12;
    float inside = smoothstep(horizon, horizon + 0.015, r);
    float ring = (r - horizon) / 0.02;
    float glow = exp(-ring * ring) * smoothstep(0.0, 0.2, p);

    col.rgb = mix(col.rgb, col.a * vec3(1.0, 0.55, 0.2), glow * 0.8);
    col *= inside;
    col *= 1.0 - smoothstep(0.85, 1.0, p);
    return col;
}
